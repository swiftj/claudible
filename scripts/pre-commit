#!/bin/bash
# Auto-bump patch version on commit
# Only bumps if there are staged changes OTHER than the version file

VERSION_FILE="cmd/claudible/main.go"

# Check if there are staged files (excluding the version file)
STAGED_FILES=$(git diff --cached --name-only | grep -v "^${VERSION_FILE}$")

if [ -z "$STAGED_FILES" ]; then
    # No other files staged, skip version bump
    exit 0
fi

# Check if version file exists
if [ ! -f "$VERSION_FILE" ]; then
    echo "Warning: Version file not found: $VERSION_FILE"
    exit 0
fi

# Extract current version
CURRENT_VERSION=$(grep -o 'Version = "[^"]*"' "$VERSION_FILE" | grep -o '[0-9]\+\.[0-9]\+\.[0-9]\+')

if [ -z "$CURRENT_VERSION" ]; then
    echo "Warning: Could not extract version from $VERSION_FILE"
    exit 0
fi

# Parse version components
IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"

# Bump patch version
NEW_PATCH=$((PATCH + 1))
NEW_VERSION="${MAJOR}.${MINOR}.${NEW_PATCH}"

# Update version in file
sed -i '' "s/Version = \"${CURRENT_VERSION}\"/Version = \"${NEW_VERSION}\"/" "$VERSION_FILE"

# Stage the version file
git add "$VERSION_FILE"

echo "Auto-bumped version: ${CURRENT_VERSION} → ${NEW_VERSION}"
